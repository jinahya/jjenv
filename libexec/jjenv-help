#!/usr/bin/env bash
# Summary: Display help for a command
#
# Usage: jjenv help [--usage] <command>
set -e

print_summaries() {
  for command in $(jjenv-commands); do
    path="$(command -v "jjenv-$command" || command -v "jjenv-sh-$command" || true)"
    [ -n "$path" ] || continue
    summary="$(extract 'Summary' "$path")"
    printf '   %-16s %s\n' "$command" "$summary"
  done
}

extract() {
  local label="$1" file="$2" in_section=0
  while IFS= read -r line; do
    case "$line" in
    "# ${label}:"* )
      in_section=1
      printf '%s\n' "${line#"# ${label}: "}"
      ;;
    "# Summary:"*|"# Usage:"*|"# Help:"* )
      in_section=0
      ;;
    "#" )
      [ "$in_section" -eq 1 ] && printf '\n'
      ;;
    "# "* )
      [ "$in_section" -eq 1 ] && printf '%s\n' "${line#\# }"
      ;;
    * )
      in_section=0
      ;;
    esac
  done < "$file"
}

usage_only=false
if [ "${1-}" = "--usage" ]; then
  usage_only=true
  shift
fi

command="${1-}"

if [ -z "$command" ]; then
  cat <<EOS
Usage: jjenv <command> [<args>...]

Additional jenv helpers.

Some useful jjenv commands are:
EOS
  print_summaries
  echo
  echo "See \`jjenv help <command>' for information on a specific command."
  exit 0
fi

path="$(command -v "jjenv-$command" || command -v "jjenv-sh-$command" || true)"
if [ -z "$path" ]; then
  echo "jjenv: no such command \`$command'" >&2
  exit 1
fi

usage="$(extract 'Usage' "$path")"
if [ -z "$usage" ]; then
  echo "Usage: jjenv $command"
else
  echo "$usage"
fi

if ! $usage_only; then
  help="$(extract 'Help' "$path")"
  if [ -n "$help" ]; then
    echo
    echo "$help"
  fi
fi
